    "id": "cpa_2026_회계학_46",
    "exam": "회계사",
    "year": "2026",
    "subject": "회계학",
    "number": "46",
    "question": "[IMAGE: cpa_2026_회계학_46_body.png]",
    "options": [
      "①₩340,000 증가",
      "②₩345,000 증가",
      "③₩350,000 증가",
      "④₩355,000 증가",
